# Kopiera till server/.env för lokal utveckling.

# Prisjämförelse via Google Shopping (https://serpapi.com – gratisnivå finns)
SERPAPI_KEY=

# Databas. Standard är en SQLite-fil:
#   lokalt:  file:local.db        (används om inget anges)
#   Docker:  file:/data/listig.db (satt i Dockerfile)
# Eller en hostad libSQL/Turso-databas:
#   DATABASE_URL=libsql://din-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Port för API:t (klienten i dev proxar /api hit)
PORT=3001
